[Trigger]
Operation = Install
Operation = Upgrade
Type = Path
Target = usr/lib/os-release
Target = etc/default/grub
Target = etc/lsb-release

[Action]
Description = @@NAME@@ Branding anwenden...
When = PostTransaction
Exec = /bin/sh -c '[ -x /usr/local/bin/@@ID@@-apply-branding ] && /usr/local/bin/@@ID@@-apply-branding; exit 0'
